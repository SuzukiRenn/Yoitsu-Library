# Copy to /etc/shared-booklist-course/app.env on the approved host.
# Set a new random key (at least 50 characters). Never copy an identity-site key.
BOOKLIST_SECRET_KEY=
BOOKLIST_QQ_EMAIL_LOGIN=0
BOOKLIST_ICP_RECORD=
# Set a real value before exposing the course site.
BOOKLIST_CONTACT_EMAIL=
# For email login, use a separately provisioned sender and private credentials.
# Optional /etc/shared-booklist-course/ai.env: COURSE_DEEPSEEK_KEY, COURSE_DEEPSEEK_MODEL,
# COURSE_DEEPSEEK_DAILY_CALLS (default 30).
