# PowerShell: set process environment explicitly; this file is documentation, not auto-loaded.
BOOKLIST_ENV=development
# Production: BOOKLIST_ENV=production, a random secret, exact hosts, and absolute external data dir.
BOOKLIST_SECRET_KEY=
BOOKLIST_ALLOWED_HOSTS=localhost,127.0.0.1
BOOKLIST_DATA_DIR=
# Exact reverse-proxy IPs only; empty keeps forwarded client addresses untrusted.
BOOKLIST_TRUSTED_PROXY_IPS=
# Approved website: sharedbooklist.xyz. An explicit empty value hides the record.
BOOKLIST_ICP_RECORD=鲁ICP备2026066257号-1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Publicly displayed contact/complaint address.
BOOKLIST_CONTACT_EMAIL=kuroneko0217@outlook.com

# Reader QQ email-code login. Configure and test SMTP before enabling. Never commit the authorization code.
BOOKLIST_QQ_EMAIL_LOGIN=0
BOOKLIST_SMTP_HOST=smtp.qq.com
BOOKLIST_SMTP_PORT=465
BOOKLIST_SMTP_USER=
BOOKLIST_SMTP_PASSWORD=
